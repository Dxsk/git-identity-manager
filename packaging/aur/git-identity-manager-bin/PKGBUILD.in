pkgname=git-identity-manager-bin
_pkgname=git-identity-manager
_bin=git-identity
pkgver=@VERSION@
pkgrel=1
pkgdesc='Switch between Git identities per repository (prebuilt static binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/Dxsk/git-identity-manager'
license=('MIT')
depends=('git')
provides=("$_pkgname")
conflicts=("$_pkgname" 'git-identity')
_base="$url/releases/download/v$pkgver"
source_x86_64=("$_pkgname-$pkgver-x86_64.tar.gz::$_base/$_bin-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.gz::$_base/$_bin-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  install -Dm755 "$_bin" "$pkgdir/usr/bin/$_bin"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}
